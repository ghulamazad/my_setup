#!/usr/bin/env bash
# =============================================================================
# neovim — Neovim setup for Arch Linux 2026
# =============================================================================
set -e

echo "Installing Neovim..."

# Neovim — latest version always in Arch repos
sudo pacman -S --needed --noconfirm \
    neovim \
    luarocks \
    tree-sitter \
    tree-sitter-cli

# lazygit — used by many neovim plugins (LazyVim, etc.)
sudo pacman -S --needed --noconfirm lazygit

# Delve — Go debugger (same as before)
go install github.com/go-delve/delve/cmd/dlv@latest

# Setup LazyVim (if no existing nvim config)
if [ ! -d ~/.config/nvim ]; then
    echo "No existing nvim config found — setting up LazyVim..."
    git clone https://github.com/LazyVim/starter ~/.config/nvim
    rm -rf ~/.config/nvim/.git
    echo "LazyVim installed!"
else
    echo "Existing nvim config found — skipping LazyVim setup"
fi

echo "Neovim installed! Version: $(nvim --version | head -1)"
