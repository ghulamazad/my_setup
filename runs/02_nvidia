#!/usr/bin/env bash
# =============================================================================
# nvidia — NVIDIA RTX 4060 driver setup for Arch Linux 2026
# Uses nvidia-open (new default for RTX 4060 in 2026)
# =============================================================================
set -e

echo "Installing NVIDIA driver..."

# Enable multilib first
if ! grep -q "^\[multilib\]" /etc/pacman.conf; then
    sudo sed -i '/^#\[multilib\]/,/^#Include = \/etc\/pacman.d\/mirrorlist/ s/^#//' /etc/pacman.conf
    sudo paru -Syy
fi

# Kernel headers — required before NVIDIA
sudo paru -S --needed --noconfirm linux-headers

# nvidia-open — correct driver for RTX 4060 (Ada Lovelace) in 2026
sudo paru -S --needed --noconfirm \
    nvidia-open \
    nvidia-utils \
    nvidia-settings \
    lib32-nvidia-utils \
    libva-nvidia-driver \
    libva-utils \
    vdpauinfo \
    nvidia-prime

# Enable DRM modeset
echo "options nvidia_drm modeset=1 fbdev=1" | sudo tee /etc/modprobe.d/nvidia.conf

# Add NVIDIA modules to initramfs
sudo sed -i 's/^MODULES=()/MODULES=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)/' /etc/mkinitcpio.conf
sudo mkinitcpio -P

echo "NVIDIA driver installed!"
echo "Reboot required: sudo reboot"
