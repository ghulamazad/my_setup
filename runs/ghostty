#!/usr/bin/env bash

# Versions
ZIG_VERSION="0.15.2"

# Derived variables
ZIG_ARCHIVE="zig-x86_64-linux-${ZIG_VERSION}"
ZIG_URL="https://ziglang.org/download/${ZIG_VERSION}/${ZIG_ARCHIVE}.tar.xz"
ZIG_INSTALL_DIR="$HOME/.local/zig"

# Download and extract Zig
wget "$ZIG_URL" -O /tmp/zig.tar.xz
mkdir -p "$HOME/.local"
tar -xf /tmp/zig.tar.xz -C "$HOME/.local"

# Replace old installation
rm -rf "$ZIG_INSTALL_DIR"
mv "$HOME/.local/$ZIG_ARCHIVE" "$ZIG_INSTALL_DIR"

# Add Zig to PATH for this session
export PATH="$ZIG_INSTALL_DIR:$PATH"

# Add Zig to PATH permanently (if not already present)
if ! grep -q '\$HOME/.local/zig' ~/.zshrc; then
    echo 'export PATH=$PATH:$HOME/.local/zig' >> ~/.zshrc
fi
