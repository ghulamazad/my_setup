# =============================================================================
# Zsh Profile & Environment
# =============================================================================
export XDG_CONFIG_HOME="$HOME/.config"
export EDITOR="nvim"
export VISUAL="nvim"
export GIT_EDITOR="nvim"

# ── Aliases ───────────────────────────────────────────────────────────────────
alias vim="nvim"
alias v="nvim"

# Safety
alias cp="cp -i"
alias mv="mv -i"
alias rm="rm -I"

# Git shortcuts
alias gs="git status -sb"
alias ga="git add"
alias gc="git commit"
alias gp="git push"
alias gpl="git pull"
alias gd="git diff"
alias gl="git log --oneline --graph --decorate"

# Config shortcuts
alias config-i3="$EDITOR ~/.config/i3/config"
alias config-nvim="$EDITOR ~/.config/nvim"
alias config-polybar="$EDITOR ~/.config/polybar"
alias config-zsh="$EDITOR ~/.zshrc"

# ── FZF Tokyo Night Theme ────────────────────────────────────────────────────
export FZF_DEFAULT_OPTS=" \
  --color=bg+:#24283b,bg:#1a1b26,spinner:#7dcfff,hl:#bb9af7 \
  --color=fg:#c0caf5,header:#7aa2f7,info:#e0af68,pointer:#7dcfff \
  --color=marker:#9ece6a,fg+:#c0caf5,prompt:#7dcfff,hl+:#bb9af7"

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# ── Keybindings ───────────────────────────────────────────────────────────────
bindkey -s ^f "tmux-sessionizer\n"

# ── Helper Functions ──────────────────────────────────────────────────────────
catr() {
    tail -n "+$1" "$3" | head -n "$(($2 - $1 + 1))"
}

cat1Line() {
    cat "$1" | tr -d "\n"
}

addToPath() {
    if [[ "$PATH" != *"$1"* ]]; then
        export PATH="$PATH:$1"
    fi
}

addToPathFront() {
    if [[ -n "$2" ]] || [[ "$PATH" != *"$1"* ]]; then
        export PATH="$1:$PATH"
    fi
}

# ── PATH Configuration ───────────────────────────────────────────────────────
addToPathFront "$HOME/.local/scripts"
addToPathFront "$HOME/.local/bin"

# Go
export GOPATH="$HOME/go"
addToPath "$GOPATH/bin"

# Rust
addToPath "$HOME/.cargo/bin"

# Java
export JAVA_HOME="/usr/lib/jvm/java-21-openjdk"
addToPath "$JAVA_HOME/bin"

# Starship Prompt
eval "$(starship init zsh)"