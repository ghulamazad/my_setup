# =============================================================================
# i3 Config — Arch Linux 2026
# HP Vectus | NVIDIA RTX 4060 | Catppuccin Mocha
# =============================================================================

# ── Colors (Catppuccin Mocha) ─────────────────────────────────────────────────
set $rosewater #f5e0dc
set $flamingo  #f2cdcd
set $pink      #f5c2e7
set $mauve     #cba6f7
set $red       #f38ba8
set $maroon    #eba0ac
set $peach     #fab387
set $yellow    #f9e2af
set $green     #a6e3a1
set $teal      #94e2d5
set $sky       #89dceb
set $sapphire  #74c7ec
set $blue      #89b4fa
set $lavender  #b4befe
set $text      #cdd6f4
set $subtext1  #bac2de
set $subtext0  #a6adc8
set $overlay2  #9399b2
set $overlay1  #7f849c
set $overlay0  #6c7086
set $surface2  #585b70
set $surface1  #45475a
set $surface0  #313244
set $base      #1e1e2e
set $mantle    #181825
set $crust     #11111b

# ── Mod Key ───────────────────────────────────────────────────────────────────
set $mod Mod1

# ── Font ─────────────────────────────────────────────────────────────────────
font pango:"JetBrains Mono" 12

# ── Window borders ───────────────────────────────────────────────────────────
for_window [class="^.*"] border pixel 2
gaps inner 6
gaps outer 2

# ── Window colors ────────────────────────────────────────────────────────────
# class                 border    backgr.  text   indicator  child_border
client.focused          $lavender $base    $text  $rosewater $lavender
client.focused_inactive $overlay0 $base    $text  $rosewater $overlay0
client.unfocused        $overlay0 $base    $text  $rosewater $overlay0
client.urgent           $peach    $base    $peach $overlay0  $peach
client.placeholder      $overlay0 $base    $text  $overlay0  $overlay0
client.background       $base

# ── Startup ──────────────────────────────────────────────────────────────────
# XDG autostart
exec --no-startup-id dex --autostart --environment i3

# NVIDIA — fix colors and screen tearing
exec --no-startup-id nvidia-settings --assign CurrentMetaMode="nvidia-auto-select +0+0 { ForceFullCompositionPipeline = On }"

# Compositor — glx backend for NVIDIA
exec --no-startup-id picom --backend glx --vsync

# Wallpaper — feh replaces nitrogen (more reliable on Arch)
exec_always --no-startup-id feh --bg-scale ~/Pictures/wallpapers/wallpaper.jpg

# Polybar
exec_always --no-startup-id $HOME/.config/polybar/launch.sh

# Network tray
exec --no-startup-id nm-applet

# Screen locker on suspend
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork --show-failed-attempts -i ~/Pictures/wallpapers/lock.png

# Auto monitor setup
exec --no-startup-id xrandr --output HDMI-1-1 --auto --left-of eDP-1
exec --no-startup-id ~/.local/scripts/monitor

# PipeWire audio (ensure running)
exec --no-startup-id systemctl --user start pipewire pipewire-pulse wireplumber

# ── Keybindings ───────────────────────────────────────────────────────────────
# Terminal — ghostty
bindsym $mod+Return exec --no-startup-id ghostty

# Kill window
bindsym $mod+Shift+q kill

# App launcher — rofi
bindsym $mod+d exec --no-startup-id rofi -show drun

# ── Focus ─────────────────────────────────────────────────────────────────────
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# ── Move ──────────────────────────────────────────────────────────────────────
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# ── Layout ────────────────────────────────────────────────────────────────────
bindsym $mod+z split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent
floating_modifier $mod
tiling_drag modifier titlebar

# ── Workspaces ────────────────────────────────────────────────────────────────
set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# App workspace assignments
assign [class="Slack"] $ws4

# Workspace monitor output
workspace 1 output HDMI-1-1
workspace 2 output HDMI-1-1

# ── System Keys ───────────────────────────────────────────────────────────────
# Volume — pamixer replaces pactl (PipeWire native, simpler)
bindsym XF86AudioRaiseVolume exec --no-startup-id pamixer -i 5
bindsym XF86AudioLowerVolume exec --no-startup-id pamixer -d 5
bindsym XF86AudioMute        exec --no-startup-id pamixer -t
bindsym XF86AudioMicMute     exec --no-startup-id pamixer --default-source -t

# Brightness — brightnessctl (already correct)
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# Media keys
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# Screenshot — flameshot replaces import/scrot
bindsym Print            exec --no-startup-id flameshot gui
bindsym $mod+Print       exec --no-startup-id flameshot screen -c
bindsym $mod+Shift+Print exec --no-startup-id flameshot full -c

# Lock screen
bindsym $mod+Shift+x exec i3lock --show-failed-attempts -i ~/Pictures/wallpapers/lock.png

# Power menu — wlogout replaces custom power-menu script
bindsym $mod+Shift+e exec --no-startup-id wlogout

# Monitor management
bindsym $mod+Shift+m exec --no-startup-id ~/.local/scripts/monitor

# Suspend
bindsym $mod+Shift+period exec systemctl suspend

# i3 control
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# ── Resize Mode ───────────────────────────────────────────────────────────────
mode "resize" {
    bindsym h resize shrink width  10 px or 10 ppt
    bindsym j resize grow   height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow   width  10 px or 10 ppt
    bindsym Left  resize shrink width  10 px or 10 ppt
    bindsym Down  resize grow   height 10 px or 10 ppt
    bindsym Up    resize shrink height 10 px or 10 ppt
    bindsym Right resize grow   width  10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"


# Bluetooth tray applet
exec --no-startup-id blueman-applet