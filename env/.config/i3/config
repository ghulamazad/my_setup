# =============================================================================
# i3 Config — Arch Linux 2026
# Tokyo Night Cohesive Dark Aesthetic
# =============================================================================

# ── Colors (Tokyo Night) ──────────────────────────────────────────────────────
set $bg           #1a1b26
set $bg_dark      #16161e
set $bg_highlight #24283b
set $terminal_black #414868
set $fg           #c0caf5
set $fg_dark      #a9b1d6
set $comment      #565f89
set $blue         #7aa2f7
set $cyan         #7dcfff
set $blue0        #3d59a1
set $blue1        #2ac3de
set $blue5        #89ddff
set $blue6        #b4f9f8
set $magenta      #bb9af7
set $purple       #9d7cd8
set $orange       #ff9e64
set $yellow       #e0af68
set $green        #9ece6a
set $teal         #73daca
set $red          #f7768e
set $border_unf   #292e42

# Semantic mappings
set $base         #1a1b26
set $mantle       #16161e
set $surface      #24283b
set $text         #c0caf5
set $subtext      #565f89
set $accent       #7aa2f7
set $accent_cyan  #7dcfff
set $urgent       #f7768e

# ── Mod Key ───────────────────────────────────────────────────────────────────
set $mod Mod1

# ── Font ─────────────────────────────────────────────────────────────────────
font pango:JetBrains Mono 11

# ── Window borders & Gaps ─────────────────────────────────────────────────────
for_window [class="^.*"] border pixel 2
gaps inner 0
gaps outer 0

# ── Window colors ────────────────────────────────────────────────────────────
# class                 border        backgr. text      indicator     child_border
client.focused          $accent       $base   $text     $accent_cyan  $accent
client.focused_inactive $border_unf   $base   $fg_dark  $border_unf   $border_unf
client.unfocused        $border_unf   $base   $subtext  $border_unf   $border_unf
client.urgent           $urgent       $base   $text     $urgent       $urgent
client.placeholder      $border_unf   $base   $text     $border_unf   $border_unf
client.background       $base

# ── Floating Window Rules ─────────────────────────────────────────────────────
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="Preferences"] floating enable
for_window [class="Pavucontrol"] floating enable, resize set 800 600, move position center
for_window [class="Lxappearance"] floating enable, resize set 800 600, move position center
for_window [class="Blueman-manager"] floating enable, resize set 800 600, move position center
for_window [class="Arandr"] floating enable
for_window [class="flameshot"] floating enable

# ── Startup ──────────────────────────────────────────────────────────────────
# XDG autostart
exec --no-startup-id dex --autostart --environment i3

# Load Xresources (DPI scaling & X11 Tokyo Night colors)
exec_always --no-startup-id xrdb -merge ~/.Xresources

# XSettings daemon for GTK dark theme & DPI synchronization
exec --no-startup-id which xsettingsd &>/dev/null && xsettingsd

# NVIDIA — fix colors and screen tearing
exec --no-startup-id nvidia-settings --assign CurrentMetaMode="nvidia-auto-select +0+0 { ForceFullCompositionPipeline = On }"

# Compositor — glx backend for NVIDIA
exec --no-startup-id picom --backend glx --vsync

# Wallpaper — feh sets desktop background
exec_always --no-startup-id feh --bg-fill ~/Pictures/wallpapers/wallpaper.jpg

# Lock screen wallpaper cache — update betterlockscreen whenever wallpaper changes
exec_always --no-startup-id betterlockscreen -u ~/Pictures/wallpapers/wallpaper.jpg

# Polybar
exec_always --no-startup-id $HOME/.config/polybar/launch.sh

# Network tray
exec --no-startup-id nm-applet

# Bluetooth tray applet
exec --no-startup-id blueman-applet

# Auto monitor setup — delegate to monitor script
exec --no-startup-id ~/.local/scripts/monitor

# PipeWire audio (ensure running)
exec --no-startup-id systemctl --user start pipewire pipewire-pulse wireplumber

# ── Keybindings ───────────────────────────────────────────────────────────────
# Terminal — ghostty
bindsym $mod+Return exec --no-startup-id ghostty

# Kill window
bindsym $mod+Shift+q kill

# App launcher — rofi
bindsym $mod+d exec --no-startup-id rofi -show drun

# ── Focus ─────────────────────────────────────────────────────────────────────
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# ── Move ──────────────────────────────────────────────────────────────────────
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# ── Layout ────────────────────────────────────────────────────────────────────
bindsym $mod+z split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent
floating_modifier $mod
tiling_drag modifier titlebar

# ── Scratchpad ────────────────────────────────────────────────────────────────
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# ── Workspaces ────────────────────────────────────────────────────────────────
set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# App workspace assignments
assign [class="Slack"] $ws4

# Workspace monitor output (DP-1 = external, eDP-1 = laptop)
workspace 1 output DP-1 eDP-1
workspace 2 output DP-1 eDP-1

# ── System Keys ───────────────────────────────────────────────────────────────
# Volume — pamixer replaces pactl (PipeWire native, simpler)
bindsym XF86AudioRaiseVolume exec --no-startup-id pamixer -i 5
bindsym XF86AudioLowerVolume exec --no-startup-id pamixer -d 5
bindsym XF86AudioMute        exec --no-startup-id pamixer -t
bindsym XF86AudioMicMute     exec --no-startup-id pamixer --default-source -t

# Brightness — brightnessctl
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# Media keys
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# Screenshot — flameshot
bindsym Print            exec --no-startup-id flameshot gui
bindsym $mod+Print       exec --no-startup-id flameshot screen -c
bindsym $mod+Shift+Print exec --no-startup-id flameshot full -c

# ── Lock screen — betterlockscreen (dimblur effect + wallpaper) ───────────────
# Manual lock: Mod+Shift+x
bindsym $mod+Shift+x exec --no-startup-id ~/.local/scripts/lock

# Auto-lock on suspend/sleep via xss-lock
exec --no-startup-id xss-lock -- ~/.local/scripts/lock

# Power menu — wlogout
bindsym $mod+Shift+e exec --no-startup-id wlogout

# Monitor management — auto-detect
bindsym $mod+Shift+m exec --no-startup-id ~/.local/scripts/monitor

# Display mode picker — like Windows Win+P
# Mod+p        → rofi menu (Extend / Mirror / Laptop / External)
# Mod+p+1..4   → direct modes (no menu)
bindsym $mod+p       exec --no-startup-id ~/.local/scripts/display
bindsym $mod+F1      exec --no-startup-id ~/.local/scripts/display laptop
bindsym $mod+F2      exec --no-startup-id ~/.local/scripts/display extend
bindsym $mod+F3      exec --no-startup-id ~/.local/scripts/display mirror
bindsym $mod+F4      exec --no-startup-id ~/.local/scripts/display external

# Suspend
bindsym $mod+Shift+period exec systemctl suspend

# Shutdown
bindsym $mod+Shift+Escape exec --no-startup-id systemctl poweroff

# i3 control
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# ── Resize Mode ───────────────────────────────────────────────────────────────
mode "resize" {
    bindsym h resize shrink width  10 px or 10 ppt
    bindsym j resize grow   height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow   width  10 px or 10 ppt
    bindsym Left  resize shrink width  10 px or 10 ppt
    bindsym Down  resize grow   height 10 px or 10 ppt
    bindsym Up    resize shrink height 10 px or 10 ppt
    bindsym Right resize grow   width  10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ── Applications ─────────────────────────────────────────────────────────────

# Chrome
bindsym $mod+c exec --no-startup-id google-chrome-stable

# Brave
bindsym $mod+b exec --no-startup-id brave-browser

# File manager
bindsym $mod+n exec --no-startup-id nautilus