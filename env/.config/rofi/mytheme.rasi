/* =============================================================================
 * Rofi Theme — Tokyo Night
 * ============================================================================= */

* {
    bg: #1a1b26;
    bg-alt: #24283b;
    fg: #c0caf5;
    fg-alt: #565f89;
    accent: #7dcfff;
    accent-blue: #7aa2f7;
    selection-bg: #292e42;
    border-col: #292e42;

    background-color: transparent;

    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 45%;
    border: 1px;
    border-color: @border-col;
    border-radius: 8px;
    background-color: @bg;
}

element {
    padding: 10px 12px;
    background-color: transparent;
    text-color: @fg-alt;
    border-radius: 4px;
    cursor: pointer;
}

element selected {
    background-color: @selection-bg;
    text-color: @accent;
}

element selected element-icon {
    background-color: transparent;
}

element selected element-text {
    background-color: transparent;
    text-color: @accent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    cursor: inherit;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 28px;
    padding: 0 10px 0 0;
    cursor: inherit;
}

entry {
    background-color: @bg-alt;
    padding: 12px;
    text-color: @fg;
}

inputbar {
    children: [prompt, entry];
    background-color: transparent;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    padding: 6px 0 0 0;
}

mainbox {
    background-color: @bg;
    children: [inputbar, listview];
}

prompt {
    background-color: @bg-alt;
    enabled: true;
    padding: 12px 0 0 12px;
    text-color: @accent-blue;
}