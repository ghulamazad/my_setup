/* =============================================================================
 * Rofi Theme — Nord
 * ============================================================================= */

* {
    bg: #2E3440;
    bg-alt: #3B4252;
    fg: #D8DEE9;
    fg-alt: #4C566A;
    accent: #88C0D0;
    accent-blue: #81A1C1;
    selection-bg: #434C5E;
    border-col: #4C566A;

    background-color: transparent;

    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 45%;
    border: 1px;
    border-color: @border-col;
    border-radius: 8px;
    background-color: @bg;
}

element {
    padding: 10px 12px;
    background-color: transparent;
    text-color: @fg-alt;
    border-radius: 4px;
    cursor: pointer;
}

element selected {
    background-color: @selection-bg;
    text-color: @accent;
}

element selected element-icon {
    background-color: transparent;
}

element selected element-text {
    background-color: transparent;
    text-color: @accent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    cursor: inherit;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 28px;
    padding: 0 10px 0 0;
    cursor: inherit;
}

entry {
    background-color: @bg-alt;
    padding: 12px;
    text-color: @fg;
}

inputbar {
    children: [prompt, entry];
    background-color: transparent;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    padding: 6px 0 0 0;
}

mainbox {
    background-color: @bg;
    children: [inputbar, listview];
}

prompt {
    background-color: @bg-alt;
    enabled: true;
    padding: 12px 0 0 12px;
    text-color: @accent-blue;
}