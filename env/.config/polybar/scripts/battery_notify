#!/bin/bash
BATTERY="/sys/class/power_supply/BAT0/capacity"
STATUS_FILE="/sys/class/power_supply/BAT0/status"
[ -f "$BATTERY" ] || exit 0
CAPACITY=$(cat "$BATTERY")
STATUS=$(cat "$STATUS_FILE")
if [ "$STATUS" = "Discharging" ] && [ "$CAPACITY" -lt 12 ]; then
    notify-send -u critical "Low Battery" "Battery at ${CAPACITY}%! Connect charger."
fi
