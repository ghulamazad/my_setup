#!/usr/bin/env bash
# =============================================================================
# Lock Screen — Tokyo Night Aesthetic (betterlockscreen dimblur / i3lock fallback)
# =============================================================================

if command -v betterlockscreen &>/dev/null; then
    betterlockscreen -l dimblur -- --time-str="%I:%M %p" --date-str="%A, %B %d"
elif [ -f "$HOME/Pictures/wallpapers/wallpaper.jpg" ]; then
    i3lock -i "$HOME/Pictures/wallpapers/wallpaper.jpg"
elif [ -f "$HOME/Pictures/wallpaper.jpg" ]; then
    i3lock -i "$HOME/Pictures/wallpaper.jpg"
else
    i3lock -c 1a1b26
fi